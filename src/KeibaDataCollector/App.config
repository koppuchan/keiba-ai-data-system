<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!--
      機密情報（利用キー、パスワード、ソフトウェアID等）はここに直接書かず、
      同名の環境変数で上書きしてください（AppConfig.cs が環境変数を優先して読みます）。
      ここに書いてよいのは非機密の既定値・雛形のみです。
    -->
    <add key="JvLinkProgId" value="JVDTLab.JVLink" />
    <!-- UmaConnの正確なProgIDは契約先の実機レジストリで確認すること（参考: koppuchan/keiba-race-result-auto-posting では NVDTLabLib.NVLink）。 -->
    <add key="UmaConnProgId" value="NVDTLabLib.NVLink" />

    <add key="JvLinkSoftwareId" value="" />

    <!-- 本番のWordPress URLに差し替えること。 -->
    <add key="WordPressBaseUrl" value="" />
    <add key="WordPressUser" value="" />
    <add key="WordPressAppPassword" value="" />

    <add key="RealtimePollIntervalSeconds" value="20" />

    <!-- license_gate等を含む全テーブルのSQLite。未指定ならbin配下の data\historical.sqlite3 を使う。 -->
    <add key="HistoricalDbPath" value="" />

    <!-- 仕様書§15の重大エラー通知用。すべて任意。未設定ならメール送信自体を行わない（AuditLogStoreへの記録・監視ダッシュボードでの確認のみ）。 -->
    <add key="SmtpHost" value="" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUseSsl" value="true" />
    <add key="SmtpUser" value="" />
    <add key="SmtpPassword" value="" />
    <add key="SmtpFrom" value="" />
    <add key="SmtpTo" value="" />
  </appSettings>
</configuration>

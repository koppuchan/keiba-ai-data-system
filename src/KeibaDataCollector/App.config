<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- 非機密の既定値のみ。利用キー・パスワード等は環境変数で注入すること（AppConfig.cs参照）。 -->
    <add key="HistoricalDbPath" value="data\historical.sqlite3" />
  </appSettings>
</configuration>

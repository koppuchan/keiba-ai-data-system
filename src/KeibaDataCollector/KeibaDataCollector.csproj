<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 2 (Issue #2) でJV-Link/UmaConnのCOM連携（32bit専用）を移植する前提のため、
    PlatformTarget は最初からx86に固定している。System.Data.SQLite.Core もx86ネイティブ
    バイナリを同梱するため、ここで揃えておかないと後で作り直しになる。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <RootNamespace>KeibaDataCollector</RootNamespace>
    <AssemblyName>KeibaDataCollector</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

</Project>

@echo off
REM Copy this file to "secrets.local.bat" in the same folder and replace the
REM placeholder values. secrets.local.bat is listed in .gitignore, so it is
REM never committed.
REM
REM IMPORTANT - keep secrets.local.bat ASCII-only with CRLF line endings.
REM cmd.exe parses .bat files byte-wise in the OEM codepage (CP932 on Japanese
REM Windows) and needs CRLF terminators. A UTF-8 Japanese comment or LF-only
REM endings make cmd misread the file and spill bytes as a command, e.g.
REM   't?@?C????' is not recognized as an internal or external command
REM which also stops the "set" lines below from being applied.

set WordPressUser=your-wp-username
set WordPressAppPassword=xxxx xxxx xxxx xxxx xxxx xxxx
set JvLinkSoftwareId=SDxxxxxx

REM Optional: error e-mail (spec section 15). Leave these out to disable e-mail.
REM Port 465 = TLS on connect, 587 = STARTTLS. Verify with: KeibaDataCollector.exe notifytest
set SmtpHost=smtp.example.com
set SmtpPort=465
set SmtpUseSsl=true
set SmtpUser=alert@example.com
set SmtpPassword=your-mail-password
set SmtpFrom=alert@example.com
set SmtpTo=ops@example.com
